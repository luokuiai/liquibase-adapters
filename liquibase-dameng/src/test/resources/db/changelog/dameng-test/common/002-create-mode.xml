<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
    <changeSet id="create-dameng-mode" author="luokuiai" dbms="dameng">
        <preConditions onFail="HALT">
            <tableExists tableName="LB_PROBE"/>
            <columnExists tableName="LB_PROBE" columnName="ID"/>
            <indexExists tableName="LB_PROBE" indexName="IX_LB_PROBE_NAME"/>
        </preConditions>
        <sql>CREATE TABLE LB_MODE (MODE_VALUE INT NOT NULL)</sql>
        <rollback>
            <sql>DROP TABLE LB_MODE</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
