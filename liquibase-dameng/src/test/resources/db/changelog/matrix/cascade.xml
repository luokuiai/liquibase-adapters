<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
    <changeSet id="cascade-setup" author="test">
        <createTable tableName="T_CASCADE_PARENT"><column name="ID" type="int"><constraints primaryKey="true" nullable="false"/></column></createTable>
        <createTable tableName="T_CASCADE_CHILD"><column name="P_ID" type="int"/></createTable>
        <addForeignKeyConstraint baseTableName="T_CASCADE_CHILD" baseColumnNames="P_ID"
                referencedTableName="T_CASCADE_PARENT" referencedColumnNames="ID" constraintName="FK_CASCADE"/>
        <rollback><dropTable tableName="T_CASCADE_CHILD"/><dropTable tableName="T_CASCADE_PARENT"/></rollback>
    </changeSet>
    <changeSet id="cascade-alter" author="test">
        <dropTable tableName="T_CASCADE_PARENT" cascadeConstraints="true"/>
        <rollback>
            <createTable tableName="T_CASCADE_PARENT"><column name="ID" type="int"><constraints primaryKey="true" nullable="false"/></column></createTable>
            <addForeignKeyConstraint baseTableName="T_CASCADE_CHILD" baseColumnNames="P_ID"
                    referencedTableName="T_CASCADE_PARENT" referencedColumnNames="ID" constraintName="FK_CASCADE"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
